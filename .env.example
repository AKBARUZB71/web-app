# ── Supabase (storage) ─────────────────────────────────────────────
# Project URL and publishable key (public, safe for clients).
SUPABASE_URL=https://nqwfchugrlorkdotyfcp.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret guarding public.akb_fs_* RPCs. 64 hex chars. Only its sha256 is in the DB.
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
AKB_DB_KEY=

# Canonical domain (no scheme). Webhook + Mini App URLs are built from it.
APP_HOST=akbartech-app.vercel.app

# ── Telegram bot ───────────────────────────────────────────────────
BOT_TOKEN=123456789:AA...
ADMIN_TG_ID=8506011274
# Key for https://<domain>/index.php?r=setup&key=SETUP_KEY (webhook connect)
SETUP_KEY=

# ── Admin panel (optional; password can be set in panel → Sozlamalar) ─
ADMIN_USER=
# bcrypt hash:  php -r 'echo password_hash("YOUR_PASSWORD", PASSWORD_BCRYPT), PHP_EOL;'
ADMIN_PASS_HASH=

# ── AI assistant (optional; can be set in admin panel) ─────────────
AI_PROVIDER=gemini
AI_KEY=
AI_MODEL=
